[Unit]
Description=Discord Private Room Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- Edit these to match your VM (run `whoami` and `which node`) ---
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/private-room-bot
ExecStart=/usr/bin/node dist/index.js
# ------------------------------------------------------------------
# dotenv loads .env from WorkingDirectory, so no EnvironmentFile is needed.
Restart=always
RestartSec=5
# Don't restart-spam if it crash-loops on a bad token:
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
